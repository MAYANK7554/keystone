# =============================================================================
# Keystone — Resilient LLM Gateway Environment Configuration
# Copy this file to .env and fill in real API keys before running.
# NEVER commit real API keys to Git.
# =============================================================================

# Comma-separated pool of at least 2 LLM API keys.
# Assigned IDs automatically in order: key_1, key_2, key_3, ...
LLM_API_KEYS=your_openai_api_key_here,your_gemini_api_key_here

# Default fallback LiteLLM model identifier
LLM_MODEL=groq/openai/gpt-oss-20b

# Comma-separated per-key models matching LLM_API_KEYS order
LLM_MODELS=groq/openai/gpt-oss-20b,gemini/gemini-3.5-flash-lite

# SQLite database path (Docker overrides this to sqlite:////data/app.db on the /data volume)
DATABASE_URL=sqlite:///./data/app.db

# Comma-separated CORS allowed origins (include your deployed frontend URL in production)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Enable X-Simulate-Failure test hook (must be true on deployed backend for failover testing)
ENABLE_FAILURE_SIMULATION=true

# LiteLLM built-in response caching ("local" for in-memory, "disk" for persistent disk cache)
CACHE_ENABLED=true
CACHE_TYPE=local
CACHE_DIR=./data/litellm_cache

# Optional: Default system prompt and per-request timeout in seconds
DEFAULT_SYSTEM_PROMPT=You are a helpful, accurate, and concise AI assistant.
LLM_TIMEOUT_SECONDS=30

# Frontend build-time API base URL
VITE_API_BASE_URL=http://localhost:8000
